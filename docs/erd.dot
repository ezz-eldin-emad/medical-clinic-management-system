digraph clinic_erd {
  graph [
    rankdir=LR,
    bgcolor="#ffffff",
    fontname="Helvetica",
    fontsize=11,
    nodesep=0.45,
    ranksep=0.85,
    pad=0.4,
    label=<<b>Medical Clinic Management System — Database ERD</b><br/><font point-size="10" color="#6b7280">Generated from backend/prisma/schema.prisma</font>>,
    labelloc=t,
    labeljust=l
  ];
  node [
    shape=plaintext,
    fontname="Helvetica",
    fontsize=10
  ];
  edge [
    color="#94a3b8",
    penwidth=1.2,
    arrowsize=0.8,
    fontname="Helvetica",
    fontsize=8,
    fontcolor="#64748b"
  ];

  roles [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#0f766e" colspan="2"><font color="#ffffff"><b>roles</b></font></td></tr>
      <tr><td align="left" bgcolor="#f0fdfa"><b>roleid</b> <font color="#0f766e">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>rolename</b> <font color="#b45309">UQ</font></td><td align="left">enum</td></tr>
    </table>
  >];

  persons [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#1d4ed8" colspan="2"><font color="#ffffff"><b>persons</b></font></td></tr>
      <tr><td align="left" bgcolor="#eff6ff"><b>userid</b> <font color="#1d4ed8">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>fullname</b></td><td align="left">varchar</td></tr>
      <tr><td align="left"><b>phonenumber</b> <font color="#b45309">UQ</font></td><td align="left">varchar</td></tr>
      <tr><td align="left"><b>roleid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>gender</b></td><td align="left">enum</td></tr>
    </table>
  >];

  users [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#1d4ed8" colspan="2"><font color="#ffffff"><b>users</b></font></td></tr>
      <tr><td align="left" bgcolor="#eff6ff"><b>userid</b> <font color="#1d4ed8">PK</font> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>email</b> <font color="#b45309">UQ</font></td><td align="left">varchar</td></tr>
      <tr><td align="left"><b>passwordhash</b></td><td align="left">varchar</td></tr>
      <tr><td align="left"><b>active</b></td><td align="left">enum</td></tr>
      <tr><td align="left"><b>registerdate</b></td><td align="left">timestamptz</td></tr>
    </table>
  >];

  otp_verification [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#1d4ed8" colspan="2"><font color="#ffffff"><b>otp_verification</b></font></td></tr>
      <tr><td align="left" bgcolor="#eff6ff"><b>userid</b> <font color="#1d4ed8">PK</font> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>otp_code</b></td><td align="left">varchar</td></tr>
      <tr><td align="left"><b>expirytime</b></td><td align="left">timestamptz</td></tr>
    </table>
  >];

  doctors [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#047857" colspan="2"><font color="#ffffff"><b>doctors</b></font></td></tr>
      <tr><td align="left" bgcolor="#ecfdf5"><b>doctorid</b> <font color="#047857">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>userid</b> <font color="#7c3aed">FK</font> <font color="#b45309">UQ</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>specialtyid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>examinationfee</b></td><td align="left">decimal</td></tr>
      <tr><td align="left"><b>consultationfee</b></td><td align="left">decimal</td></tr>
      <tr><td align="left"><b>biography</b></td><td align="left">text?</td></tr>
    </table>
  >];

  patients [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#047857" colspan="2"><font color="#ffffff"><b>patients</b></font></td></tr>
      <tr><td align="left" bgcolor="#ecfdf5"><b>patientid</b> <font color="#047857">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>userid</b> <font color="#7c3aed">FK</font> <font color="#b45309">UQ</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>yearofbirth</b></td><td align="left">int</td></tr>
    </table>
  >];

  specialties [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#7c3aed" colspan="2"><font color="#ffffff"><b>specialties</b></font></td></tr>
      <tr><td align="left" bgcolor="#f5f3ff"><b>specialtyid</b> <font color="#7c3aed">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>name</b></td><td align="left">varchar</td></tr>
    </table>
  >];

  rooms [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#7c3aed" colspan="2"><font color="#ffffff"><b>rooms</b></font></td></tr>
      <tr><td align="left" bgcolor="#f5f3ff"><b>roomid</b> <font color="#7c3aed">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>roomname</b></td><td align="left">varchar</td></tr>
    </table>
  >];

  doctorschedules [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#b45309" colspan="2"><font color="#ffffff"><b>doctorschedules</b></font></td></tr>
      <tr><td align="left" bgcolor="#fffbeb"><b>scheduleid</b> <font color="#b45309">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>doctorid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>roomid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>weekday</b></td><td align="left">enum</td></tr>
      <tr><td align="left"><b>starttime</b></td><td align="left">time</td></tr>
      <tr><td align="left"><b>endtime</b></td><td align="left">time</td></tr>
      <tr><td align="left"><b>maxcapacity</b></td><td align="left">int</td></tr>
    </table>
  >];

  appointments [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#be123c" colspan="2"><font color="#ffffff"><b>appointments</b></font></td></tr>
      <tr><td align="left" bgcolor="#fff1f2"><b>appointmentid</b> <font color="#be123c">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>patientid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>scheduleid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>doctorid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>appointmenttype</b></td><td align="left">enum</td></tr>
      <tr><td align="left"><b>status</b></td><td align="left">enum?</td></tr>
      <tr><td align="left"><b>appointmentdate</b></td><td align="left">date</td></tr>
    </table>
  >];

  medicalrecords [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#cbd5e1">
      <tr><td bgcolor="#be123c" colspan="2"><font color="#ffffff"><b>medicalrecords</b></font></td></tr>
      <tr><td align="left" bgcolor="#fff1f2"><b>recordid</b> <font color="#be123c">PK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>appointmentid</b> <font color="#7c3aed">FK</font></td><td align="left">int</td></tr>
      <tr><td align="left"><b>diagnosis</b></td><td align="left">text</td></tr>
      <tr><td align="left"><b>prescription</b></td><td align="left">text</td></tr>
      <tr><td align="left"><b>notes</b></td><td align="left">text?</td></tr>
    </table>
  >];

  roles -> persons [label="roleid", arrowtail=teeodot, arrowhead=crow, dir=both];
  persons -> users [label="userid", arrowtail=teeodot, arrowhead=tee, dir=both];
  persons -> otp_verification [label="userid", arrowtail=teeodot, arrowhead=tee, dir=both];
  persons -> doctors [label="userid", arrowtail=teeodot, arrowhead=tee, dir=both];
  persons -> patients [label="userid", arrowtail=teeodot, arrowhead=tee, dir=both];
  specialties -> doctors [label="specialtyid", arrowtail=teeodot, arrowhead=crow, dir=both];
  doctors -> doctorschedules [label="doctorid", arrowtail=teeodot, arrowhead=crow, dir=both];
  rooms -> doctorschedules [label="roomid", arrowtail=teeodot, arrowhead=crow, dir=both];
  doctors -> appointments [label="doctorid", arrowtail=teeodot, arrowhead=crow, dir=both];
  patients -> appointments [label="patientid", arrowtail=teeodot, arrowhead=crow, dir=both];
  doctorschedules -> appointments [label="scheduleid", arrowtail=teeodot, arrowhead=crow, dir=both];
  appointments -> medicalrecords [label="appointmentid", arrowtail=teeodot, arrowhead=crow, dir=both];
}
